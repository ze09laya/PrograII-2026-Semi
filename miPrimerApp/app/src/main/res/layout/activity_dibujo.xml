<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8E1">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_fondo_divertido"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <!-- MASCOTA -->
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/dibujo"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_card_fun"
                android:padding="6dp"
                android:layout_marginEnd="10dp"/>

            <!-- TITULOS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zona Creativa"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="26sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dibuja y guarda tus ideas"
                    android:textColor="#F3E5F5"
                    android:textSize="12sp"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>

            <!-- BOTON SALIR -->
            <LinearLayout
                android:id="@+id/btnSalir"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_circle_purple"
                android:gravity="center"
                android:elevation="6dp">

                <TextView
                    android:id="@+id/btnCerrar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="✖"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:background="@drawable/bg_circle_purple" />
            </LinearLayout>

        </LinearLayout>

        <!-- BADGES ROW -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_purple"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginEnd="6dp">


                <TextView
                    android:id="@+id/txtArtista"
                    android:text="★ Novato"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B388FF"
                    android:textStyle="bold"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_purple"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/txtDibujos"
                    android:text="♥ 0 dibujos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B388FF"
                    android:textStyle="bold"
                    android:textSize="11sp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- CUERPO -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- TARJETA LIENZO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/bg_input_round"
            android:padding="14dp">

            <!-- TITULO TARJETA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/dibujo"
                    android:background="@drawable/bg_circle_purple"
                    android:padding="5dp"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Area de dibujo"
                    android:textColor="#FFD600"
                    android:textStyle="bold"
                    android:textSize="18sp"/>

            </LinearLayout>

            <!-- LIENZO -->
            <FrameLayout
                android:id="@+id/contenedorLienzo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_foto_dashed_purple"
                android:padding="10dp"/>

            <!-- HINT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_purple"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★  "
                    android:textColor="#FFD600"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Usa tu imaginacion y crea algo divertido"
                    android:textColor="#B39DDB"
                    android:textSize="11sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- PALETA DE COLORES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp">

            <View android:id="@+id/colorRojo"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="#F44336"
                android:layout_margin="4dp"/>

            <View android:id="@+id/colorNaranja"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="#FF9800"
                android:layout_margin="4dp"/>

            <View android:id="@+id/colorAmarillo"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="#FFD600"
                android:layout_margin="4dp"/>

            <View android:id="@+id/colorVerde"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="#4CAF50"
                android:layout_margin="4dp"/>

            <View android:id="@+id/colorMorado"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="#7C4DFF"
                android:layout_margin="4dp"/>

        </LinearLayout>

        <!-- BOTONES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <!-- LIMPIAR -->
            <LinearLayout
                android:id="@+id/btnLimpiar"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_fun"
                android:gravity="center"
                android:orientation="vertical"
                android:elevation="8dp"
                android:padding="8dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_delete"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Limpiar"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginTop="3dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Borrar todo"
                    android:textColor="#FFE0B0"
                    android:textSize="10sp"/>

            </LinearLayout>

            <!-- GUARDAR -->
            <LinearLayout
                android:id="@+id/btnGuardar"
                android:layout_width="0dp"
                android:layout_height="76dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_purple"
                android:gravity="center"
                android:orientation="vertical"
                android:elevation="8dp"
                android:padding="8dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_save"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guardar"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:layout_marginTop="3dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Guardar dibujo"
                    android:textColor="#D0B8FF"
                    android:textSize="10sp"/>

            </LinearLayout>



        </LinearLayout>

    </LinearLayout>

    <!-- BOTON VER DIBUJOS -->
    <LinearLayout
        android:id="@+id/btnVerDibujos"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_fondo_divertido"
        android:gravity="center"
        android:orientation="horizontal"
        android:elevation="8dp"
        android:padding="10dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/dinosaurio"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mis Dibujos"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="15sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver dibujos guardados"
                android:textColor="#E1BEE7"
                android:textSize="11sp"/>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>