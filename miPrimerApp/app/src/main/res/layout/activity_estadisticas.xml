<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8E1">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_fondo_divertido"
        android:paddingBottom="14dp">

        <!-- TOP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <!-- ICONO -->
            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/dinosaurio"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_card_fun"
                android:padding="8dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="Icono Dinosaurio"/>

            <!-- TITULOS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mis Emociones"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="26sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Descubre cómo te sentiste"
                    android:textColor="#F3E5F5"
                    android:textSize="12sp"
                    android:layout_marginTop="3dp"/>

            </LinearLayout>

            <!-- NUEVO: BOTON SALIR (X) -->
            <LinearLayout
                android:id="@+id/btnSalir"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_circle_purple"
                android:gravity="center"
                android:elevation="6dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="20sp"/>
            </LinearLayout>

        </LinearLayout>

        <!-- BADGES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_purple"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:layout_marginEnd="6dp">

                <TextView
                    android:text="📊 Estadísticas"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B388FF"
                    android:textStyle="bold"
                    android:textSize="11sp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_purple"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">

                <TextView
                    android:text="😊 Emociones"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B388FF"
                    android:textStyle="bold"
                    android:textSize="11sp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- CONTENIDO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- TARJETA ESTADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_input_round"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <!-- TITULO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:src="@drawable/nino"
                        android:background="@drawable/bg_circle_purple"
                        android:padding="5dp"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="Icono Niño"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Estado emocional"
                        android:textColor="#FFD600"
                        android:textStyle="bold"
                        android:textSize="18sp"/>

                </LinearLayout>

                <!-- ESTADO -->
                <TextView
                    android:id="@+id/txtEstado"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="😊 Estado emocional"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:gravity="center"
                    android:layout_marginBottom="14dp"/>

                <!-- PROGRESS -->
                <ProgressBar
                    android:id="@+id/progressEmocion"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="24dp"
                    android:max="100"
                    android:progress="0"/>

                <!-- PORCENTAJE -->
                <TextView
                    android:id="@+id/txtPorcentaje"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#FF9800"
                    android:textStyle="bold"
                    android:textSize="22sp"
                    android:gravity="center"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>

            <!-- RESUMEN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_input_round"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:src="@drawable/dibujo"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="Icono Dibujo"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resumen emocional"
                        android:textColor="#FFD600"
                        android:textStyle="bold"
                        android:textSize="18sp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/txtResumen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sin datos"
                    android:textColor="#444444"
                    android:textSize="16sp"/>

            </LinearLayout>

            <!-- HINT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input_purple"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="★ "
                    android:textColor="#FFD600"
                    android:textSize="14sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Las emociones se calculan automáticamente"
                    android:textColor="#B39DDB"
                    android:textSize="11sp"/>

            </LinearLayout>

            <!-- BOTON -->
            <LinearLayout
                android:id="@+id/btnEnviarCorreo"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:background="@drawable/bg_button_fun"
                android:gravity="center"
                android:orientation="horizontal"
                android:elevation="8dp"
                android:padding="10dp">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_dialog_email"
                    android:layout_marginEnd="10dp"
                    android:contentDescription="Icono Correo"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enviar alerta"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="15sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Avisar al padre o tutor"
                        android:textColor="#FFE0B0"
                        android:textSize="11sp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>